generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AssetStatus {
  IN_USE
  AVAILABLE
  RESERVE
  MAINTENANCE
  AWAITING_INSTALL
  DISPOSED
  INACTIVE
}

enum AssetKind {
  COMPUTER
  MONITOR
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  contactEmail          String?                @unique @map("contact_email")
  passwordHash          String                 @map("password_hash")
  fullName              String                 @map("full_name")
  role                  Role                   @default(USER)
  mustChangePassword    Boolean                @default(false) @map("must_change_password")
  otpHash               String?                @map("otp_hash")
  otpExpiresAt          DateTime?              @map("otp_expires_at")
  createdDate           DateTime               @default(now()) @map("created_date")
  updatedDate           DateTime               @updatedAt @map("updated_date")
  movimentacoes         Movimentacao[]
  apuracoesModernizacao ApuracaoModernizacao[]

  @@map("users")
}

model Departamento {
  id           String         @id @default(cuid())
  codigo       String         @unique
  nome         String
  nivel        Int            @default(1)
  parentId     String?        @map("parent_id")
  parent       Departamento?  @relation("DepartamentoTree", fields: [parentId], references: [id])
  children     Departamento[] @relation("DepartamentoTree")
  sortOrder    Int            @default(0) @map("sort_order")
  createdDate  DateTime       @default(now()) @map("created_date")
  updatedDate  DateTime       @updatedAt @map("updated_date")
  computadores Computador[]
  monitores    Monitor[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("departamentos")
}

model Servidor {
  id           String       @id @default(cuid())
  nome         String
  matricula    String?      @unique
  cargo        String?
  createdDate  DateTime     @default(now()) @map("created_date")
  updatedDate  DateTime     @updatedAt @map("updated_date")
  computadores Computador[]
  monitores    Monitor[]

  @@index([nome])
  @@map("servidores")
}

model Localizacao {
  id           String       @id @default(cuid())
  nome         String
  cidade       String       @default("")
  uf           String?
  createdDate  DateTime     @default(now()) @map("created_date")
  updatedDate  DateTime     @updatedAt @map("updated_date")
  computadores Computador[]
  monitores    Monitor[]

  @@index([cidade])
  @@index([nome])
  @@map("localizacoes")
}

model Computador {
  id                String         @id @default(cuid())
  tombo             String         @unique
  serialNumber      String?        @unique @map("serial_number")
  fabricante        String?
  modelo            String?
  status            AssetStatus    @default(AVAILABLE)
  processador       String?
  memoriaRam        String?        @map("memoria_ram")
  armazenamento     String?
  observacoes       String?
  usuario           String?
  servidorId        String?        @map("servidor_id")
  servidor          Servidor?      @relation(fields: [servidorId], references: [id])
  departamentoId    String?        @map("departamento_id")
  departamento      Departamento?  @relation(fields: [departamentoId], references: [id])
  localizacaoId     String?        @map("localizacao_id")
  localizacao       Localizacao?   @relation(fields: [localizacaoId], references: [id])
  dataNotaFiscal    DateTime?      @map("data_nota_fiscal") @db.Date
  dataRecebimento   DateTime?      @map("data_recebimento") @db.Date
  prazoGarantiaAnos Int?           @map("prazo_garantia_anos")
  createdDate       DateTime       @default(now()) @map("created_date")
  updatedDate       DateTime       @updatedAt @map("updated_date")
  deletedAt         DateTime?      @map("deleted_at")
  groupId           String?        @map("group_id")
  movimentacoes     Movimentacao[]

  @@index([modelo])
  @@index([status])
  @@index([departamentoId])
  @@index([localizacaoId])
  @@index([servidorId])
  @@index([fabricante])
  @@index([dataRecebimento])
  @@index([groupId])
  @@map("computadores")
}

model Monitor {
  id                String         @id @default(cuid())
  tombo             String         @unique
  serialNumber      String?        @unique @map("serial_number")
  fabricante        String?
  modelo            String?
  tamanho           String?
  resolucao         String?
  conexoes          String?
  status            AssetStatus    @default(AVAILABLE)
  observacoes       String?
  usuario           String?
  servidorId        String?        @map("servidor_id")
  servidor          Servidor?      @relation(fields: [servidorId], references: [id])
  departamentoId    String?        @map("departamento_id")
  departamento      Departamento?  @relation(fields: [departamentoId], references: [id])
  localizacaoId     String?        @map("localizacao_id")
  localizacao       Localizacao?   @relation(fields: [localizacaoId], references: [id])
  groupId           String?        @map("group_id")
  dataNotaFiscal    DateTime?      @map("data_nota_fiscal") @db.Date
  dataRecebimento   DateTime?      @map("data_recebimento") @db.Date
  prazoGarantiaAnos Int?           @map("prazo_garantia_anos")
  createdDate       DateTime       @default(now()) @map("created_date")
  updatedDate       DateTime       @updatedAt @map("updated_date")
  deletedAt         DateTime?      @map("deleted_at")
  movimentacoes     Movimentacao[]

  @@index([modelo])
  @@index([status])
  @@index([departamentoId])
  @@index([groupId])
  @@index([servidorId])
  @@index([fabricante])
  @@index([dataRecebimento])
  @@map("monitores")
}

model Movimentacao {
  id            String      @id @default(cuid())
  kind          AssetKind
  campo         String
  valorAnterior String?     @map("valor_anterior")
  valorNovo     String?     @map("valor_novo")
  createdDate   DateTime    @default(now()) @map("created_date")
  actorId       String?     @map("actor_id")
  actor         User?       @relation(fields: [actorId], references: [id])
  computadorId  String?     @map("computador_id")
  computador    Computador? @relation(fields: [computadorId], references: [id])
  monitorId     String?     @map("monitor_id")
  monitor       Monitor?    @relation(fields: [monitorId], references: [id])

  @@index([createdDate])
  @@index([computadorId])
  @@index([monitorId])
  @@map("movimentacoes")
}

model ApuracaoModernizacao {
  id             String   @id @default(cuid())
  ano            Int      @unique
  dataReferencia DateTime @map("data_referencia") @db.Date
  escopo         String   @default("computadores_e_monitores")
  resultado      Json
  equipamentos   Json
  observacao     String?
  createdById    String?  @map("created_by_id")
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdDate    DateTime @default(now()) @map("created_date")

  @@index([ano])
  @@map("apuracoes_modernizacao")
}
